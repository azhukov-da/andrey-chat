<?xml version="1.0" encoding="utf-8" ?>
<!--
  Coverage configuration for the backend integration layer.

  Every exclusion the measurement applies is declared here rather than being applied ad hoc,
  which is what automated-testing/code-coverage-gate/exclusions-are-declared requires. The list
  below is reproduced in the generated report by ReportGenerator and summarised by
  tools/coverage-gate.

  Passed to dotnet test with the "settings" option, alongside the XPlat Code Coverage collector.
  See test.bat for the exact invocation.
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>

          <!-- Assemblies that are test scaffolding rather than the system under test. -->
          <Exclude>[Tests.Integration]*,[Tests.Load]*,[xunit.*]*</Exclude>

          <!-- EF Core migrations and the compiled model are generated; DTOs and options types are
               data carriers with no behaviour to verify. -->
          <ExcludeByFile>**/Migrations/**/*.cs,**/*.Designer.cs,**/*.g.cs,**/*.generated.cs</ExcludeByFile>
          <ExcludeByAttribute>Obsolete,GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>

          <!-- DTOs and options types are property bags crossing a boundary; SkipAutoProps keeps
               their accessors out of the denominator so it holds only code that can be wrong. -->
          <SkipAutoProps>true</SkipAutoProps>

          <IncludeTestAssembly>false</IncludeTestAssembly>
          <SingleHit>false</SingleHit>
          <UseSourceLink>false</UseSourceLink>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
